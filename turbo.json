{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "WARQA_BASE",
        "WARQA_REPO_URL",
        "GITHUB_REPOSITORY"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "passThroughEnv": [
        "CI",
        "WARQA_E2E_URL",
        "WARQA_CORS_CHECK"
      ]
    }
  }
}
