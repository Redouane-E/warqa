# https://editorconfig.org — matches biome.json (2 spaces, LF, 120 columns).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
max_line_length = off

[*.py]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
