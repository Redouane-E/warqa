            { "id": "r1", "text": "Subtracting a number is the same as adding its opposite.", "correct": "t", "why": "$a − b = a + (−b)$." },
            { "id": "r2", "text": "$5 − (−3) = 2$", "correct": "f", "why": "$5 − (−3) = 5 + 3 = 8$." },
            { "id": "r3", "text": "The additive inverse of $−12$ is $12$.", "correct": "t", "why": "$−12 + 12 = 0$." },
