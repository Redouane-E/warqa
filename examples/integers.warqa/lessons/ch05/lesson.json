    {
      "id": "wrap",
      "title": "Summary",
      "move": "summary",
      "narration": "To subtract, add the opposite. [[w1]]Keep the first number, change minus to plus, and change the second number to its opposite. [[w2]]Subtracting a positive number moves you left. [[w3]]Subtracting a negative number moves you right. [[end]]Now try the chapter practice.",
      "scene": {
        "clear": true,
        "add": [
          {
            "id": "sum",
            "type": "list",
            "items": [
              { "text": "To subtract, add the opposite: keep, change, change.", "sub": "$a − b = a + (−b)$" },
              { "text": "Subtracting a positive number moves you left.", "sub": "$2 − 5 = 2 + (−5) = −3$" },
              { "text": "Subtracting a negative number moves you right.", "sub": "$2 − (−5) = 2 + 5 = 7$" }
            ]
          }
        ]
      },
      "cues": [
        { "at": 0.4, "do": "show", "target": "sum#item:0" },
        { "at": "w1", "do": "pulse", "target": "sum#item:0", "args": { "amount": 0.06 } },
        { "at": "w2", "do": "show", "target": "sum#item:1" },
        { "at": "w3", "do": "show", "target": "sum#item:2" },
        { "at": "end", "do": "dim", "target": "sum" }
      ]
    },
