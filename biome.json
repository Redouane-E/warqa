{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "packages/*/src/**",
      "packages/*/scripts/**",
      "packages/*/build.mjs",
      "apps/*/src/**",
      "apps/*/vite.config.ts",
      "e2e/**/*.ts",
      "evals/*.mts",
      "!**/dist",
      "!**/node_modules",
      "!**/*.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        "noForEach": "off",
        "noImportantStyles": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off",
        "noApproximativeNumericConstant": "off"
      },
      "a11y": {
        "useSemanticElements": "warn"
      }
    }
  }
}
