# Copy to .env and fill in the providers you use. Keys stay on your machine; Warqa never writes them into
# book projects or exports. One key is enough to start (see `warqa models status`).

# --- language models (any of these) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# --- local or self-hosted servers (defaults shown) ---
# OLLAMA_BASE_URL=http://localhost:11434/api
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# VLLM_BASE_URL=http://localhost:8000/v1
# WARQA_COMPAT_BASE_URL=        # any OpenAI-compatible endpoint
# WARQA_COMPAT_API_KEY=
# WARQA_COMPAT_STRUCTURED=1     # set if the endpoint supports JSON Schema output

# --- speech (optional; "edge" needs no key) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=

# --- misc ---
# WARQA_HOME=~/.warqa           # model catalog cache, studio keys
# WARQA_DEBUG=1                 # stack traces in the CLI
