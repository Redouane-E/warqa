{
  "name": "@warqa/lesson",
  "version": "0.2.0",
  "description": "Warqa lesson format (Zod schema, compiler, validators) and the framework-free player.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "default": "./dist/player/index.js"
    },
    "./gestures": {
      "types": "./dist/player/gestures.d.ts",
      "default": "./dist/player/gestures.js"
    },
    "./bundle/*": "./dist/bundle/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@warqa/brand": "workspace:*",
    "@warqa/i18n": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/topojson-client": "^3.1.5",
    "happy-dom": "^20.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
