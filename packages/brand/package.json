{
  "name": "@warqa/brand",
  "version": "0.2.0",
  "description": "Warqa's design system: colour, type, space and motion tokens (TypeScript and CSS), the bundled fonts, the mark and the icons.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./icons/*": "./dist/icons/*",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/playpen-sans-arabic": "^5.3.0",
    "@fontsource/stix-two-text": "^5.3.0",
    "@napi-rs/canvas": "^1.0.11"
  }
}
