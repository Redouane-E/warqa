{
  "name": "@warqa/studio",
  "version": "0.1.0",
  "description": "Warqa studio: a local web app to turn PDFs into animated, narrated lessons — plan, build, edit, translate, narrate and export.",
  "license": "Apache-2.0",
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@warqa/i18n": "workspace:*",
    "@warqa/lesson": "workspace:*",
    "@warqa/pipeline": "workspace:*",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2"
  }
}
