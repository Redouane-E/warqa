{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm build)",
      "Bash(pnpm build *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm e2e)",
      "Bash(pnpm e2e *)",
      "Bash(pnpm docs:components)",
      "Bash(pnpm --filter @warqa/brand build)",
      "Bash(pnpm --filter @warqa/brand typecheck)",
      "Bash(pnpm --filter @warqa/brand test)",
      "Bash(pnpm --filter @warqa/brand test *)",
      "Bash(pnpm --filter @warqa/i18n build)",
      "Bash(pnpm --filter @warqa/i18n typecheck)",
      "Bash(pnpm --filter @warqa/i18n test)",
      "Bash(pnpm --filter @warqa/i18n test *)",
      "Bash(pnpm --filter @warqa/lesson build)",
      "Bash(pnpm --filter @warqa/lesson typecheck)",
      "Bash(pnpm --filter @warqa/lesson test)",
      "Bash(pnpm --filter @warqa/lesson test *)",
      "Bash(pnpm --filter @warqa/pipeline build)",
      "Bash(pnpm --filter @warqa/pipeline typecheck)",
      "Bash(pnpm --filter @warqa/pipeline test)",
      "Bash(pnpm --filter @warqa/pipeline test *)",
      "Bash(pnpm --filter @warqa/cli build)",
      "Bash(pnpm --filter @warqa/cli typecheck)",
      "Bash(pnpm --filter @warqa/cli test)",
      "Bash(pnpm --filter @warqa/cli test *)",
      "Bash(pnpm --filter @warqa/mcp build)",
      "Bash(pnpm --filter @warqa/mcp typecheck)",
      "Bash(pnpm --filter @warqa/mcp test)",
      "Bash(pnpm --filter @warqa/mcp test *)",
      "Bash(pnpm --filter @warqa/studio build)",
      "Bash(pnpm --filter @warqa/studio typecheck)",
      "Bash(pnpm --filter @warqa/studio test)",
      "Bash(pnpm --filter @warqa/studio test *)",
      "Bash(pnpm --filter @warqa/web build)",
      "Bash(pnpm --filter @warqa/web typecheck)",
      "Bash(pnpm --filter @warqa/web test)",
      "Bash(pnpm --filter @warqa/web test *)",
      "Bash(pnpm --filter @warqa/web e2e)",
      "Bash(pnpm --filter @warqa/web e2e *)",
      "Bash(pnpm --filter @warqa/e2e test)",
      "Bash(pnpm --filter @warqa/e2e test *)",
      "Bash(pnpm warqa validate *)",
      "Bash(pnpm warqa qa *)",
      "Bash(pnpm warqa export *)",
      "Bash(pnpm warqa review *)",
      "Bash(pnpm warqa --help)",
      "Bash(pnpm warqa * --help)",
      "Bash(npx turbo run *)",
      "Bash(npx vitest run *)",
      "Bash(npx biome check *)",
      "Bash(npx biome format *)",
      "Bash(npx tsc -p * --noEmit)",
      "Bash(npx playwright test *)",
      "Bash(uv run --locked --with pytest pytest *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(pnpm warqa build *)",
      "Bash(pnpm warqa plan *)",
      "Bash(pnpm warqa translate *)",
      "Bash(pnpm warqa improve *)",
      "Bash(pnpm warqa illustrate *)",
      "Bash(pnpm warqa ingest *)",
      "Bash(pnpm eval *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.local)",
      "Read(**/.env.*.local)",
      "Read(~/.warqa/**)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Edit(./.env.local)",
      "Bash(cat .env)",
      "Bash(cat .env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
